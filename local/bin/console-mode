#!/usr/bin/env bash

MONITOR="HDMI-A-1"
RESOLUTION="3840x2160@144"
POSITION="-3840x0"
GAME_WORKSPACE="9"

# Define your sinks
AUDIO_SINK_NORMAL="alsa_output.usb-Yamaha_Corporation_Steinberg_UR22-00.analog-stereo"
AUDIO_SINK_TV="alsa_output.pci-0000_01_00.1.hdmi-stereo"

# Check if monitor is active
MONITOR_ACTIVE=$(hyprctl monitors -j | jq -r ".[] | select(.name==\"$MONITOR\") | .dpmsStatus")

if [[ "$MONITOR_ACTIVE" == "true" ]]; then
    echo "Disabling game mode (turning off $MONITOR)..."

    # Switch back to normal sink
    echo "Switching audio to sound card ($AUDIO_SINK_NORMAL)..."
    pactl set-default-sink "$AUDIO_SINK_NORMAL"

    # Turn off TV
    hyprctl eval "hl.monitor({ output = \"$MONITOR\", disabled = true })"
    exit 0
else
    echo "Enabling game mode on $MONITOR..."

    # Turn on the TV
    hyprctl eval "hl.monitor({ output = \"$MONITOR\", mode = \"$RESOLUTION\", position = \"$POSITION\", scale = 1, vrr = 1, disabled = false })"
    sleep 2

    # Set as primary for Xwayland
    xrandr --output "$MONITOR" --primary

    # Switch audio to TV
    echo "Switching audio to TV ($AUDIO_SINK_TV)..."
    pactl set-default-sink "$AUDIO_SINK_TV"

    # Game workspace on the TV, focused: shown (created if needed), moved to the TV, which it follows
    # since it's shown, then focused there
    hyprctl dispatch "hl.dsp.focus({ workspace = $GAME_WORKSPACE })"
    hyprctl dispatch "hl.dsp.workspace.move({ workspace = $GAME_WORKSPACE, monitor = \"$MONITOR\" })"
    hyprctl dispatch "hl.dsp.focus({ workspace = $GAME_WORKSPACE })"

  #  # Launch Steam Big Picture
  #  if pgrep -x "steam" > /dev/null; then
  #      echo "Steam is already running; switching to Big Picture..."
  #      steam steam://open/bigpicture &
  #  else
  #      echo "Launching Steam in Big Picture mode..."
  #      steam -tenfoot >/dev/null 2>&1 &
  #  fi
fi

