#!/usr/bin/env bash
# Switches the system palette.
#
#   theme            the palettes, the current one marked
#   theme <name>     switch to it ("rose-pine-moon", or just "moon")
#   theme next       the next one, round the list
#
#   theme font                       the fonts: ui (Quickshell), mono (kitty, Hyprland), app (GTK and Qt apps)
#   theme font <ui|mono|app> <name>  use that font family there ("Noto Sans")
#   theme font <ui|mono|app> default back to theme.json's
#   theme font <ui|mono|app> size <n|default>   its size: pixels for ui, points for mono and app
#
# It writes the palette's name to ~/.local/state/theme/palette, out of the dotfiles so switching never shows up
# in git (theme.json's "palette" is only the default, for a new machine). Quickshell sees the change and
# brings every app up to date (config/theme/apply.sh). When Quickshell isn't running, this runs apply.sh.
# Fonts work the same way: the ones picked are in ~/.local/state/theme/fonts.json, over theme.json's.

set -euo pipefail

source "$HOME/.config/theme/lib.sh"

dir=$THEME_DIR
settings="$dir/theme.json"
state="$THEME_STATE/palette"
fonts="$THEME_STATE/fonts.json"

# the other apps follow by themselves when Quickshell is running (it watches the state files)
apply_if_no_shell() {
    if ! pgrep -x qs >/dev/null && ! pgrep -x quickshell >/dev/null; then
        "$dir/apply.sh"
    fi
}

# writes the picked fonts in one step (a new file renamed over the old), as for the palette, then applies
save_fonts() {
    mkdir -p "$(dirname "$fonts")"
    printf '%s\n' "$1" >"$fonts.tmp"
    mv "$fonts.tmp" "$fonts"
    apply_if_no_shell
}

if [[ ${1:-} == font ]]; then
    picked=$(cat "$fonts" 2>/dev/null || true)
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"$picked" || picked='{}'

    # each font's size, in theme.json's names
    declare -A size_key=([ui]=uiPixelSize [mono]=monoPointSize [app]=appPointSize)
    declare -A unit=([ui]=px [mono]=pt [app]=pt)

    if [[ $# -eq 1 ]]; then
        for key in ui mono app; do
            default=$(jq -r --arg k "$key" '.font[$k] // .font.ui' "$settings")
            mine=$(jq -r --arg k "$key" '.[$k] // empty' <<<"$picked")
            size=$(jq -r --arg k "${size_key[$key]}" '.[$k] // empty' <<<"$picked")
            [[ -n $size ]] || size="$(jq -r --arg k "${size_key[$key]}" '.font[$k]' "$settings") (default)"
            printf '%-5s %-40s %s %s\n' "$key" "${mine:-$default (default)}" "${unit[$key]}" "$size"
        done
        exit 0
    fi

    # theme font <key> size <n|default>
    if [[ ${3:-} == size && $# -eq 4 && ${2:-} =~ ^(ui|mono|app)$ ]]; then
        k=${size_key[$2]}
        if [[ $4 == default ]]; then
            picked=$(jq --arg k "$k" 'del(.[$k])' <<<"$picked")
        elif [[ $4 =~ ^[0-9]+$ ]] && (( $4 >= 6 && $4 <= 40 )); then
            picked=$(jq --arg k "$k" --argjson n "$4" '.[$k] = $n' <<<"$picked")
        else
            echo "theme: a size is a whole number from 6 to 40, or default" >&2
            exit 1
        fi
        save_fonts "$picked"
        exit 0
    fi

    key=${2:-}
    family=${3:-}
    if [[ ! $key =~ ^(ui|mono|app)$ || -z $family || $# -gt 3 ]]; then
        echo "usage: theme font [<ui|mono|app> <family|default> | <ui|mono|app> size <n|default>]" >&2
        exit 1
    fi
    if [[ $family == default ]]; then
        picked=$(jq --arg k "$key" 'del(.[$k])' <<<"$picked")
    elif grep -qxF -- "$family" <<<"$(fc-list : family | tr ',' '\n')"; then
        picked=$(jq --arg k "$key" --arg f "$family" '.[$k] = $f' <<<"$picked")
    else
        echo "theme: no font family named '$family' (fc-list : family lists them)" >&2
        exit 1
    fi

    save_fonts "$picked"
    exit 0
fi

mapfile -t names < <(find "$dir/palettes/" -maxdepth 1 -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort)
current=$(theme_palette_name)

if [[ $# -eq 0 ]]; then
    for n in "${names[@]}"; do
        title=$(jq -r '.name' "$dir/palettes/$n.json")
        if [[ $n == "$current" ]]; then
            printf '* %-18s %s\n' "$n" "$title"
        else
            printf '  %-18s %s\n' "$n" "$title"
        fi
    done
    exit 0
fi

wanted=$1
if [[ $wanted == next ]]; then
    wanted=${names[0]}
    for i in "${!names[@]}"; do
        if [[ ${names[i]} == "$current" ]]; then
            wanted=${names[(i + 1) % ${#names[@]}]}
        fi
    done
elif [[ ! -f "$dir/palettes/$wanted.json" && -f "$dir/palettes/rose-pine-$wanted.json" ]]; then
    wanted="rose-pine-$wanted"
fi

if [[ ! -f "$dir/palettes/$wanted.json" ]]; then
    echo "theme: no palette named '$1' (theme lists them)" >&2
    exit 1
fi
# "already" only when the state file says so too: it may name a palette that's gone, `current` then being
# the default, and switching to the default must still write it
saved=$(head -n 1 "$state" 2>/dev/null | tr -d '[:space:]' || true)
if [[ $wanted == "$current" && $saved == "$wanted" ]]; then
    echo "already $wanted"
    exit 0
fi

# in one step (a new file renamed over the old), so nothing ever reads half a name
mkdir -p "$(dirname "$state")"
printf '%s\n' "$wanted" >"$state.tmp"
mv "$state.tmp" "$state"
jq -r '.name' "$dir/palettes/$wanted.json"
apply_if_no_shell
