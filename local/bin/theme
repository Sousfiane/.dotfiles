#!/usr/bin/env bash
# Switches the system palette.
#
#   theme            the palettes, the current one marked
#   theme <name>     switch to it ("rose-pine-moon", or just "moon")
#   theme next       the next one, round the list
#
# It writes the palette's name to ~/.local/state/theme/palette, out of the dotfiles so switching never shows up
# in git (theme.json's "palette" is only the default, for a new machine). Quickshell sees the change and
# brings every app up to date (config/theme/apply.sh). When Quickshell isn't running, this runs apply.sh.

set -euo pipefail

dir="$HOME/.config/theme"
settings="$dir/theme.json"
state="$HOME/.local/state/theme/palette"

mapfile -t names < <(find "$dir/palettes/" -maxdepth 1 -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort)
current=$(head -n 1 "$state" 2>/dev/null | tr -d '[:space:]')
[[ -n $current ]] || current=$(jq -r '.palette' "$settings")

if [[ $# -eq 0 ]]; then
    for n in "${names[@]}"; do
        title=$(jq -r '.name' "$dir/palettes/$n.json")
        if [[ $n == "$current" ]]; then
            printf '* %-18s %s\n' "$n" "$title"
        else
            printf '  %-18s %s\n' "$n" "$title"
        fi
    done
    exit 0
fi

wanted=$1
if [[ $wanted == next ]]; then
    wanted=${names[0]}
    for i in "${!names[@]}"; do
        if [[ ${names[i]} == "$current" ]]; then
            wanted=${names[(i + 1) % ${#names[@]}]}
        fi
    done
elif [[ ! -f "$dir/palettes/$wanted.json" && -f "$dir/palettes/rose-pine-$wanted.json" ]]; then
    wanted="rose-pine-$wanted"
fi

if [[ ! -f "$dir/palettes/$wanted.json" ]]; then
    echo "theme: no palette named '$1' (theme lists them)" >&2
    exit 1
fi
if [[ $wanted == "$current" ]]; then
    echo "already $wanted"
    exit 0
fi

# in one step (a new file renamed over the old), so nothing ever reads half a name
mkdir -p "$(dirname "$state")"
printf '%s\n' "$wanted" >"$state.tmp"
mv "$state.tmp" "$state"
echo "$(jq -r '.name' "$dir/palettes/$wanted.json")"

if ! pgrep -x qs >/dev/null && ! pgrep -x quickshell >/dev/null; then
    "$dir/apply.sh"
fi
