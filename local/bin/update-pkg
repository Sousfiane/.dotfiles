#!/usr/bin/env bash
# The pending updates in fzf (repo, then AUR, each "name old -> new"), and on enter a full upgrade.
#
# There's no picking single packages: on Arch that's a partial upgrade (new packages against old
# libraries), which can break the system. checkupdates lists the repo updates from its own copy of the
# databases, so nothing is synced here until yay -Syu does it all at once.

fzf_args=(
    --header 'enter: upgrade everything | esc: cancel'
    --preview 'yay -Si {1} 2>/dev/null || yay -Qi {1}'
    --preview-label='alt-p: toggle preview | alt-j/k: scroll'
    --preview-label-pos='bottom'
    --preview-window 'down:45%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:yellow,marker:yellow'
)

echo "Checking for updates..."
updates=$(
    checkupdates
    yay -Qua 2>/dev/null
)

if [[ -z $updates ]]; then
    echo "System is already up to date."
    sleep 1
    exit 0
fi

fzf "${fzf_args[@]}" <<<"$updates" >/dev/null || exit 0

yay -Syu --noconfirm
