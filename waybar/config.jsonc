{
  "reload_style_on_change": true,
  "layer": "top",
  "output": [
    "DP-1",
    "DP-2"
  ],
  "position": "top",
  "spacing": 0,
  "height": 32,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
      "custom/dotfiles",
      "custom/pacman",
      "pulseaudio",
      "custom/bluetooth",
      "network",
      "battery",
      "custom/menu"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",

    "tooltip": true,
    "tooltips": {
        "default": "Workspace {name}:\n{windows}",
        "empty": "Workspace {name}: empty"
    },

    "format-window-separator": "\n",

    "format-icons": {
        "default": "",
        "active": "󱓻"
    },
    "window-rewrite-default": "",
    "window-rewrite": {
        "class<.*> title<.*>": "{class} : {title}"
    }
  },
  "clock": {
    "format": "{:L%A %H:%M}",
    "format-alt": "{:L%d %B %Y}",
    "tooltip": false
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "uwsm-app -- xdg-terminal-exec --app-id=FloatingTerm -e impala",
    "on-click-right": "uwsm-app -- nm-connection-editor"
  },
  "battery": {
    "format": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󱐋", "󱐋", "󱐋", "󱐋", "󱐋", "󱐋", "󱐋", "󱐋", "󱐋", "󱐋"],
      "default": ["", "", "", "", "", "", "", "", "", ""]
    },
    "format-full": "󱐋",
    "tooltip-format-discharging": "{capacity}% {time}",
    "tooltip-format-charging": "{capacity}% {time}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "on-click": "os-menu power-profiles"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "uwsm-app -- xdg-terminal-exec --app-id=FloatingTerm -e wiremix",
    "on-click-right": "headset-toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    },
        "tray": {
        "icon-size": 32,
        "spacing": 32
    }
  },
  "custom/pacman": {
      "format": "{} ",
      "return-type": "json",
      "interval": 3600,
      "tooltip": true,
      "on-click": "pkill -SIGRTMIN+8 waybar",
      "on-click-right": "os-menu update",
      "signal": 8,
      "exec": "~/.dotfiles/waybar/custom/pacman.sh"
  },
  "custom/dotfiles": {
      "format": "{} ",
      "return-type": "json",
      "interval": 10,
      "tooltip": true,
      "on-click": "pkill -SIGRTMIN+9 waybar",
      "on-click-right": "os-menu dotfiles",
      "signal": 9,
      "exec": "~/.dotfiles/waybar/custom/dotfiles.sh"
  },
  "custom/menu": {
      "format": "󱗼",
      "tooltip": false,
      "on-click": "os-menu"
  },
  "custom/bluetooth": {
    "exec": "~/.dotfiles/waybar/custom/bt-status.sh",
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
    "interval": 2
  }
}
