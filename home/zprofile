[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# the repo: always here (install/install.sh refuses to run from anywhere else)
export DOTFILES="$HOME/.dotfiles"

# fzf's and ls's colours, from the theme (zshrc keeps them up to date in open shells)
if [[ -r "$HOME/.config/zsh/theme.zsh" ]]; then
    source "$HOME/.config/zsh/theme.zsh"
    shell_theme
fi
