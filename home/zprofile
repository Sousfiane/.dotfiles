[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

source_if_exists () {
    if test -r "$1"; then
        source "$1"
    fi
}

# the repo: always here (install/install.sh refuses to run from anywhere else)
export DOTFILES="$HOME/.dotfiles"

# fzf's colours, from the theme (zshrc keeps them up to date in open shells)
if [[ -r "$HOME/.config/zsh/fzf.zsh" ]]; then
    source "$HOME/.config/zsh/fzf.zsh"
    fzf_theme
fi
